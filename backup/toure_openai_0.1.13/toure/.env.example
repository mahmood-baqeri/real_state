# =============================================================================
# .env.example —  نمونه تنظیمات محیط (Local / Development)
# =============================================================================
# استفاده:
#   copy .env.example .env         (Windows CMD)
#   Copy-Item .env.example .env    (PowerShell)
#   cp .env.example .env           (Bash)
#
# سپس مقادیر را برای محیط لوکال تنظیم کنید.
# =============================================================================

# -----------------------------------------------------------------------------
# Django — Core
# -----------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE="config.settings.development"
DJANGO_SECRET_KEY="change-me-in-production-use-strong-random-key"
DJANGO_DEBUG="True"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1,0.0.0.0"
DJANGO_SECURE_SSL_REDIRECT="0"
DJANGO_SECURE_HSTS_SECONDS="0"

# -----------------------------------------------------------------------------
# Field-Level Encryption (Fernet)
# -----------------------------------------------------------------------------
# تولید کلید:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DJANGO_FIELD_ENCRYPTION_KEY=""

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_DB="realestate_db"
POSTGRES_USER="realestate_user"
POSTGRES_PASSWORD="realestate_pass"
POSTGRES_TEST_DB="realestate_test_db"
POSTGRES_PORT="5433"
DATABASE_URL="postgresql://realestate_user:realestate_pass@127.0.0.1:5433/realestate_db"
TEST_DATABASE_URL="postgresql://realestate_user:realestate_pass@127.0.0.1:5433/realestate_test_db"

# -----------------------------------------------------------------------------
# Redis & Celery
# -----------------------------------------------------------------------------
REDIS_URL="redis://127.0.0.1:6380/0"
REDIS_PORT="6380"
HTTP_PORT="8080"

# در لوکال: "1" = celery task ها eager اجرا شوند (بدون نیاز به worker)
CELERY_EAGER="1"

# -----------------------------------------------------------------------------
# JWT & Inter-Service Auth
# -----------------------------------------------------------------------------
JWT_SIGNING_KEY="change-me-shared-jwt-signing-secret"
JWT_ACCESS_LIFETIME_MINUTES="15"
JWT_REFRESH_LIFETIME_DAYS="7"

# -----------------------------------------------------------------------------
# Default Localization (Configurable per Agency / User)
# -----------------------------------------------------------------------------
DEFAULT_COUNTRY="IR"
DEFAULT_LANGUAGE="fa"
DEFAULT_CALENDAR="jalali"
DEFAULT_CURRENCY="IRT"
DEFAULT_TIMEZONE="UTC"

# -----------------------------------------------------------------------------
# External Provider Adapters (Dev → Sandbox/Console/OSM)
# -----------------------------------------------------------------------------
ACTIVE_PAYMENT_PROVIDER="sandbox"
ACTIVE_SMS_PROVIDER="console"
ACTIVE_MAP_PROVIDER="osm"

# -----------------------------------------------------------------------------
# CORS — فرانت Next.js
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001"

# -----------------------------------------------------------------------------
# Service URLs (Backend ports)
# -----------------------------------------------------------------------------
# Django (admin + ORM + webhook)
DJANGO_URL="http://127.0.0.1:8010"
# FastAPI (Sole Web API Layer)
FASTAPI_URL="http://127.0.0.1:8020"

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="سامانه سازمانی املاک"
NEXT_PUBLIC_DEFAULT_LOCALE="fa"
NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:8020"
INTERNAL_DJANGO_URL="http://127.0.0.1:8010"
INTERNAL_FASTAPI_URL="http://127.0.0.1:8020"

# -----------------------------------------------------------------------------
# AI Studio Runtime (اختیاری — اگر از AI Studio استفاده می‌کنید)
# -----------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# Email (لوکال: چاپ روی کنسول)
# -----------------------------------------------------------------------------
EMAIL_BACKEND="django.core.mail.backends.console.EmailBackend"
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_USE_TLS="True"
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""
DEFAULT_FROM_EMAIL="noreply@example.com"